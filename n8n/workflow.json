    },
    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.output.match(/```json([\\s\\S]*?)```/)[1]);\n\nreturn [{\n  agent_spec_v2: {\n    agent_name: \"Clara Receptionist\",\n    company: data.company_name,\n    capabilities: [\n      \"call answering\",\n      \"job qualification\",\n      \"appointment scheduling\",\n      \"after-hours call filtering\"\n    ],\n    integrations: {\n      crm: data.crm_system\n    },\n    escalation_rules: data.call_transfer_rules,\n    pricing_rules: data.pricing\n  }\n}];"
      },

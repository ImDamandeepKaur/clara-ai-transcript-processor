    {
      "parameters": {
        "jsCode": "const data = JSON.parse($json.output.match(/```json([\\s\\S]*?)```/)[1]);\n\nreturn [{\n  agent_spec_v1: {\n    agent_name: \"Clara Receptionist\",\n    company: data.company_name,\n    role: \"AI receptionist for electrical service company\",\n    services_supported: data.services_offered,\n    call_transfer_rules: data.call_transfer_rules,\n    pricing: data.pricing,\n    notifications: data.notification_preferences\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",

        "jsCode": "return [{\n  changelog: `\n# Agent Configuration Changelog\n\n## Version 1\nInitial AI receptionist configuration based on demo and onboarding call transcripts.\n\nFeatures:\n- Handles incoming customer calls\n- Captures service requests\n- Transfers calls to Ben when required\n- Integrates with Jobber CRM\n\n## Version 2\nImproved agent capabilities.\n\nEnhancements:\n- Better job qualification\n- After-hours call filtering\n- CRM integration improvements\n- Structured pricing rules\n`\n}];"
      },
